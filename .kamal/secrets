# Secrets for config/deploy.yml. This file is committed: it only says where each value comes from,
# never the value itself.

# Read from the key file, which is never committed.
RAILS_MASTER_KEY=$(cat config/master.key)

# Exported in the shell that runs kamal, from a password manager. Used by the app and by the
# PostgreSQL accessory.
SPOTTER_DATABASE_PASSWORD=$SPOTTER_DATABASE_PASSWORD
