{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./config/master.key)",
      "Read(./config/credentials/**)",
      "Read(./config/*.key)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./config/master.key)",
      "Edit(./config/credentials/**)",
      "Edit(./config/*.key)",
      "Bash(rails credentials:*)",
      "Bash(bin/rails credentials:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude/guard-bash.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
