<% content_for :title, t(".title") %>

<div class="mx-auto w-full max-w-md">
  <h1 class="font-bold text-3xl"><%= t(".title") %></h1>
  <p class="mt-4"><%= t(".body") %></p>
  <%= render "components/flash" %>

  <%= form_with url: recovery_code_path, class: "mt-6 space-y-4" do |form| %>
    <%= form.label :code, t(".code"), class: "block font-medium" %>
    <%= form.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code", spellcheck: false,
      class: "block w-full rounded border border-gray-400 px-3 py-2 font-mono" %>
    <%= form.submit t(".submit"), class: "rounded px-4 py-2 bg-blue-700 text-white font-medium cursor-pointer" %>
  <% end %>
</div>
