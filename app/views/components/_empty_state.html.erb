<%# locals: (title:, body: nil, action_label: nil, action_href: nil) %>
<div class="rounded-card border-2 border-dashed border-line-strong px-5 py-10 text-center">
  <h2 class="text-lg font-semibold"><%= title %></h2>
  <% if body %>
    <p class="mx-auto mt-2 max-w-prose text-muted"><%= body %></p>
  <% end %>
  <% if action_label && action_href %>
    <div class="mt-6">
      <%= render "components/button", label: action_label, href: action_href %>
    </div>
  <% end %>
</div>
