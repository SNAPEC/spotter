<% content_for :title, t(".title") %>

<div class="mx-auto w-full max-w-md">
  <h1 class="font-bold text-3xl"><%= t(".title") %></h1>
  <p class="mt-4"><%= t(".body") %></p>
  <%= render "components/flash" %>

  <%= form_with url: passkey_session_path, class: "mt-6 space-y-4",
    data: { turbo: false, controller: "webauthn", action: "webauthn#start",
            webauthn_ceremony_value: "get", webauthn_options_url_value: options_passkey_session_path } do |form| %>
    <%= form.hidden_field :credential, data: { webauthn_target: "credential" } %>
    <p class="py-2 px-3 bg-red-50 text-red-700 rounded" role="alert" hidden data-webauthn-target="error"><%= t(".browser_failed") %></p>
    <%= form.submit t(".submit"), class: "rounded px-4 py-2 bg-blue-700 text-white font-medium cursor-pointer" %>
  <% end %>

  <p class="mt-6"><%= link_to t(".recovery_code"), new_recovery_code_path, class: "underline" %></p>
</div>
