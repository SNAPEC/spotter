<% content_for :title, t(".title") %>

<div class="mx-auto w-full max-w-md">
  <h1 class="font-bold text-3xl"><%= t(".title") %></h1>

  <%= render "components/flash" %>

  <%= form_with url: login_path, class: "mt-6 space-y-6" do |form| %>
    <%= render "components/text_field", form: form, attribute: :email, label: t(".email"), as: :email_field,
      input: { required: true, autofocus: true, autocomplete: "email" } %>
    <%= render "components/button", label: t(".submit"), full: true %>
  <% end %>
</div>
